{
  "name": "dsh-notify-sounds",
  "version": "2.0.1",
  "description": "DeepSeek Harness 提示音插件（网页端与桌面端通用）：智能体需要选择（提问/审批）或任务完成时播放短提示音，并在屏幕右下角弹出原生通知。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "notification",
    "sound",
    "web"
  ],
  "license": "MIT",
  "author": {
    "name": "星乐",
    "email": "1148958503@qq.com",
    "url": "https://github.com/Half-xingle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Half-xingle/dsh-notify-sounds.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/build.mjs --verify",
    "test": "node scripts/build.mjs --verify && node test/smoke.mjs && node test/status-source.mjs && node test/host-smoke.mjs && node test/build-smoke.mjs",
    "prepublishOnly": "npm test",
    "prepare": "node scripts/build.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
