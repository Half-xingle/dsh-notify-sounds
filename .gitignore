# dependencies installed by npm/pnpm
node_modules/

# temporary install dry-run layouts
.tmp-*/

# editor/OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# stray output
*.log
*.tgz

# local dev notes
DEVELOPMENT.md

# NOTE: lib/ is intentionally NOT ignored -- it is the committed build output so the
# plugin is installable with zero build steps. `node scripts/build.mjs --verify`
# (wired into `npm test`) fails when lib/ drifts from src/.
